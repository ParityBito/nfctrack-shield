# Shield Environment Variables
# Copy this file to .env and fill in the values.
# All variables are required unless marked as optional.

# ──────────────────────────────────────────────
# General
# ──────────────────────────────────────────────
PORT=5173
APP_HOST=http://localhost:5173

# ──────────────────────────────────────────────
# Authentication (Keycloak OAuth2/OIDC)
# ──────────────────────────────────────────────
CLIENT_ID=shield-app
CLIENT_SECRET=your-keycloak-client-secret
ISSUER_URL=https://auth.stg.fc-safety.com/realms/shield/
USERINFO_URL=https://auth.stg.fc-safety.com/realms/shield/protocol/openid-connect/userinfo
LOGOUT_URL=https://auth.stg.fc-safety.com/realms/shield/protocol/openid-connect/logout
REDIRECT_URL=http://localhost:5173/callback

# Session & Cookies
SESSION_SECRET=generate-a-random-64-char-hex-string
COOKIE_SECRET=generate-a-random-64-char-hex-string

# ──────────────────────────────────────────────
# Backend API
# ──────────────────────────────────────────────
API_BASE_URL=https://shield-api.stg.fc-safety.app

# ──────────────────────────────────────────────
# AWS (S3 + CloudFront CDN)
# ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_ACCESS_KEY_SECRET=your-aws-secret-access-key
AWS_REGION=us-west-2
AWS_PUBLIC_BUCKET=fc-shield-public
AWS_PUBLIC_CDN_URL=https://content.fc-safety.com
AWS_PRIVATE_BUCKET=fc-shield-private
AWS_PRIVATE_CDN_URL=https://vault.fc-safety.com
AWS_PRIVATE_CDN_KEY_PAIR_ID=your-cloudfront-key-pair-id
AWS_PRIVATE_CDN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-rsa-private-key-for-signed-urls\n-----END PRIVATE KEY-----"

# Optional: how long signed URLs remain valid (default: 3600 seconds / 1 hour)
# AWS_PRIVATE_OBJECT_EXPIRATION_SECONDS=3600

# ──────────────────────────────────────────────
# Image Processing CDN (imgproxy)
# ──────────────────────────────────────────────
IMAGE_PROCESSING_CDN_HOST=https://img.fc-safety.com
IMAGE_PROCESSING_KEY=your-imgproxy-key
IMAGE_PROCESSING_SALT=your-imgproxy-salt

# ──────────────────────────────────────────────
# External Services
# ──────────────────────────────────────────────
ZIPCODESTACK_API_KEY=your-zipcodestack-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ──────────────────────────────────────────────
# Error Tracking (Sentry)
# ──────────────────────────────────────────────
SENTRY_ENVIRONMENT=local
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ──────────────────────────────────────────────
# Optional / Defaults
# ──────────────────────────────────────────────
# FONT_AWESOME_KIT_ID=02452665a9
# POST_LOGOUT_URL=
